# ====== Hypergrow — variáveis de ambiente ======
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA suba o .env.local para o GitHub (já está no .gitignore).

# --- Supabase (banco de leads) ---
# Pegue em: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role) — usada só no servidor para salvar leads
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp (botão de contato) ---
# Número com DDI e DDD, só dígitos. Ex: 5532999999999
NEXT_PUBLIC_WHATSAPP=

# --- Painel admin / CRM ---
# Senha para entrar em /admin (escolha uma forte)
ADMIN_PASSWORD=
# Segredo para assinar a sessão do admin (string aleatória longa)
ADMIN_SECRET=

# --- Cobranças Asaas ---
# Chave de API do Asaas (Configurações > Integrações > API). Produção: $aact_...
# ASAAS_API_KEY=
# Token do webhook do Asaas (você escolhe; o mesmo no painel Asaas e aqui)
# ASAAS_WEBHOOK_TOKEN=
# (opcional) base sandbox: https://sandbox.asaas.com/api/v3
# ASAAS_BASE=

# --- Agente de IA (OpenAI) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Agendamento de reunião (Cal.com) ---
# Seu link público do Cal.com (ex: hypergrow/reuniao)
# NEXT_PUBLIC_CALCOM_LINK=
# Segredo do webhook do Cal.com (Settings > Webhooks) — joga a reunião no CRM
# CALCOM_WEBHOOK_SECRET=

# --- E-mail (quando tiver Resend/SendGrid) ---
# RESEND_API_KEY=
# LEAD_NOTIFY_EMAIL=
# Remetente. Sem isso, usa "HyperGrow <onboarding@resend.dev>" (só entrega
# para o dono da conta Resend, até verificar um domínio próprio).
# RESEND_FROM=

# --- Motor de automações (lembretes/confirmações por e-mail) ---
# Segredo que protege /api/cron. Sem isto, a rota fica desligada (503) e
# nenhuma régua dispara. Escolha uma string aleatória longa e cole a mesma
# no agendador externo (ex. cron-job.org) como header Authorization ou
# query ?secret=.
# CRON_SECRET=

# --- Analytics / eventos de conversão (GA4 e/ou GTM) ---
# Sem nenhum dos dois preenchidos, components/Analytics.tsx não carrega
# nada e os eventos de components/lib/track.ts só empilham no dataLayer
# sem ninguém ler — preencha ao menos um para medir de verdade.
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=
